page {
  min-height: 100%;
  color: #2f251f;
  background: #f6f1e9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  margin: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.page-with-cart {
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #a44732;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 760;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #756a61;
  font-size: 25rpx;
  line-height: 1.6;
}

.surface {
  background: #fffdfa;
  border: 1rpx solid #e8dfd4;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(69, 48, 35, 0.055);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 40rpx 2rpx 18rpx;
}

.section-heading-title {
  font-size: 31rpx;
  font-weight: 720;
}

.section-heading-copy {
  color: #8d8177;
  font-size: 22rpx;
}

.primary-button,
.secondary-button,
.quiet-button,
.danger-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-button {
  color: #ffffff;
  background: #a44732;
  box-shadow: 0 10rpx 22rpx rgba(164, 71, 50, 0.18);
}

.primary-button.button-hover {
  background: #8c3928;
}

.primary-button[disabled] {
  color: #b3aaa2;
  background: #e8e2da;
  box-shadow: none;
}

.secondary-button {
  color: #483b34;
  background: #fffdfa;
  border: 1rpx solid #d8cdc0;
}

.secondary-button.button-hover,
.quiet-button.button-hover {
  background: #e9e2d9;
}

.quiet-button {
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  color: #756a61;
  background: #eee8df;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.danger-button {
  color: #963232;
  background: #f8e4e2;
}

.loading-state,
.empty-state,
.error-state {
  display: flex;
  min-height: 380rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 50rpx 34rpx;
  color: #8d8177;
  text-align: center;
}

.state-mark {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  color: #a44732;
  background: #f4e4de;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.state-title {
  color: #2a211c;
  font-size: 30rpx;
  font-weight: 700;
}

.state-copy {
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.loading-dot {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #dfd5ca;
  border-top-color: #a44732;
  border-radius: 50%;
  animation: spin 700ms linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-pill,
.source-pill {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  min-height: 44rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-waiting {
  color: #7b4b14;
  background: #faead5;
}

.status-done {
  color: #2f6b4f;
  background: #e1eee7;
}

.status-muted {
  color: #756a61;
  background: #ece7df;
}

.source-pay {
  color: #426a79;
  background: #e2edf1;
}

.source-coupon {
  color: #77551a;
  background: #f6eacb;
}

.source-mixed {
  color: #8b3d2a;
  background: #f6e3dc;
}

.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  background: rgba(35, 27, 22, 0.5);
}

.bottom-sheet {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 88vh;
  padding: 32rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: #fffdfa;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -20rpx 50rpx rgba(45, 31, 22, 0.16);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: -8rpx auto 24rpx;
  background: #d8cfc5;
  border-radius: 999rpx;
}

.sheet-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 750;
}

.sheet-price {
  color: #a44732;
  font-size: 34rpx;
  font-weight: 750;
}

.close-button {
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: #756a61;
  background: #eee8df;
  border-radius: 20rpx;
  font-size: 32rpx;
}

.close-button.button-hover {
  background: #dfd7cd;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4b4038;
  font-size: 25rpx;
  font-weight: 700;
}

.text-input,
.text-area {
  width: 100%;
  min-height: 84rpx;
  padding: 18rpx 20rpx;
  color: #2a211c;
  background: #ffffff;
  border: 1rpx solid #d7cdc1;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.text-area {
  min-height: 130rpx;
}

.safe-bottom-space {
  height: env(safe-area-inset-bottom);
}
