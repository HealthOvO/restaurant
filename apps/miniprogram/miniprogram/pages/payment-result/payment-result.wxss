.result-page { display: flex; align-items: center; justify-content: center; }
.result-card { display: flex; width: 100%; max-width: 650rpx; min-height: 620rpx; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 48rpx 34rpx; border-radius: 30rpx; text-align: center; }
.result-loader { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; background: #f1ebe3; border-radius: 28rpx; }
.result-title { font-size: 36rpx; font-weight: 750; }
.result-kicker { color: #2f6b4f; font-size: 23rpx; font-weight: 700; letter-spacing: 3rpx; }
.result-copy { max-width: 500rpx; color: #756a61; font-size: 24rpx; line-height: 1.6; }
.pickup-label { margin-top: 10rpx; color: #8d8177; font-size: 23rpx; }
.pickup-number { color: #a44732; font-size: 116rpx; font-weight: 820; line-height: 1; letter-spacing: -4rpx; }
.result-points { margin: 8rpx 0 12rpx; padding: 12rpx 18rpx; color: #7b4b14; background: #faead5; border-radius: 999rpx; font-size: 23rpx; font-weight: 650; }
.result-card .primary-button,
.result-card .quiet-button { width: 100%; margin-top: 8rpx; }
