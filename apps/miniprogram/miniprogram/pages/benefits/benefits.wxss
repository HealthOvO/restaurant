.benefits-page { padding-bottom: 44rpx; }

.benefit-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 32rpx;
  color: #fffaf3;
  background: linear-gradient(145deg, #3d302a, #594035);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 30rpx;
  box-shadow: 0 16rpx 34rpx rgba(55,39,30,.14);
}

.benefit-hero::before,
.benefit-hero::after {
  position: absolute;
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 50%;
  content: "";
}

.benefit-hero::before { top: -118rpx; right: -70rpx; width: 250rpx; height: 250rpx; }
.benefit-hero::after { right: 62rpx; bottom: -126rpx; width: 190rpx; height: 190rpx; }
.benefit-hero .eyebrow { position: relative; z-index: 1; color: #efc596; }
.benefit-balance { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 14rpx; margin: 18rpx 0 10rpx; }
.benefit-balance strong { font-size: 72rpx; line-height: 1; letter-spacing: -2rpx; }
.benefit-balance text { color: #e7d9ce; font-size: 23rpx; }
.benefit-hero > text:last-child { position: relative; z-index: 1; color: #d9c9bc; font-size: 23rpx; }

.segment-control {
  display: flex;
  gap: 8rpx;
  margin: 24rpx 0 6rpx;
  padding: 7rpx;
  background: #e9e1d7;
  border: 1rpx solid #dfd5c8;
  border-radius: 20rpx;
}

.segment-control button {
  flex: 1;
  min-height: 72rpx;
  margin: 0;
  padding: 14rpx;
  color: #756a61;
  background: transparent;
  border-radius: 15rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.segment-control button.is-active {
  color: #2a211c;
  background: #fffdf9;
  box-shadow: 0 5rpx 14rpx rgba(56,39,28,.09);
}

.benefit-section-heading { align-items: center; }
.benefit-section-heading > view { display: flex; align-items: baseline; gap: 12rpx; }
.section-count { color: #9a8f86; font-size: 20rpx; }
.exchange-list,
.coupon-list { display: flex; flex-direction: column; gap: 18rpx; }

.exchange-card {
  display: flex;
  overflow: hidden;
  flex-direction: column;
  padding: 0;
  border-radius: 26rpx;
}

.exchange-card.is-disabled { background: #f5f1eb; }
.exchange-card-top { display: flex; align-items: flex-start; gap: 20rpx; padding: 26rpx 26rpx 22rpx; }
.ticket-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: #a44732;
  background: #f7e4db;
  border: 1rpx solid #efd0c3;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.exchange-card.is-disabled .ticket-mark { color: #8d8177; background: #ebe5dd; border-color: #e0d8cf; }
.exchange-content { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.exchange-name { color: #2a211c; font-size: 29rpx; font-weight: 760; line-height: 1.35; }
.exchange-copy { color: #6f6258; font-size: 22rpx; }
.exchange-validity { color: #9a8f86; font-size: 20rpx; }
.exchange-card-bottom {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 18rpx 22rpx 20rpx 26rpx;
  background: #fbf6ef;
  border-top: 1rpx solid #eee5db;
}

.exchange-card.is-disabled .exchange-card-bottom { background: #eee9e2; }
.exchange-cost { display: flex; min-width: 118rpx; align-items: baseline; gap: 6rpx; color: #a44732; }
.exchange-cost strong { font-size: 36rpx; line-height: 1; }
.exchange-cost text { color: #8d8177; font-size: 20rpx; }
.exchange-card.is-disabled .exchange-cost,
.exchange-card.is-disabled .exchange-cost text { color: #8f867e; }
.exchange-button {
  min-width: 0;
  min-height: 72rpx;
  flex: 1;
  margin: 0;
  padding: 12rpx 20rpx;
  color: #fff;
  background: #a44732;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 720;
}

.exchange-button[disabled] { color: #8f867e; background: #ded7cf; }

.coupon-card {
  position: relative;
  display: flex;
  overflow: hidden;
  flex-direction: column;
  gap: 17rpx;
  padding: 26rpx;
  color: #81776f;
  background: #f0ebe4;
  border: 1rpx solid #dfd7cd;
  border-radius: 28rpx;
}

.coupon-card::before,
.coupon-card::after {
  position: absolute;
  top: 112rpx;
  width: 22rpx;
  height: 22rpx;
  background: #f4f0e9;
  border: 1rpx solid #dfd7cd;
  border-radius: 50%;
  content: "";
}

.coupon-card::before { left: -12rpx; }
.coupon-card::after { right: -12rpx; }
.coupon-card.is-available {
  color: #2a211c;
  background: #fffaf1;
  border-color: #e1cba8;
  box-shadow: 0 12rpx 28rpx rgba(101,72,45,.065);
}

.coupon-card.is-available::before,
.coupon-card.is-available::after { border-color: #e1cba8; }
.coupon-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.coupon-status-pill {
  padding: 6rpx 13rpx;
  color: #74685f;
  background: #e4ddd4;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.coupon-card.is-available .coupon-status-pill { color: #2f6b4f; background: #e3efe7; }
.coupon-kicker { color: #9a8f86; font-size: 20rpx; }
.coupon-name { color: #2a211c; font-size: 32rpx; font-weight: 780; line-height: 1.35; }
.coupon-detail {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #ded2c2;
}

.coupon-detail + .coupon-detail { margin-top: -9rpx; padding-top: 8rpx; border-top: 0; }
.coupon-detail text { color: #978b82; font-size: 21rpx; }
.coupon-detail strong { color: #5c5048; font-size: 21rpx; font-weight: 650; text-align: right; }
.coupon-use-button {
  width: 100%;
  min-height: 76rpx;
  margin: 2rpx 0 0;
  color: #fff;
  background: #a44732;
  border-radius: 19rpx;
  font-size: 24rpx;
  font-weight: 730;
}

.coupon-use-button[disabled] { color: #8f867e; background: #ded7cf; }
.coupon-finished {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  color: #8f867e;
  background: #e4ded6;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.points-list { padding: 0 24rpx; }
.point-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eee7dd; }
.point-row:last-child { border-bottom: 0; }
.point-row > view { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; font-size: 26rpx; font-weight: 650; }
.point-row small { color: #8d8177; font-size: 20rpx; font-weight: 400; }
.point-row strong { flex: 0 0 auto; font-size: 29rpx; }
.point-row .is-positive { color: #2f6b4f; }
.point-row .is-negative { color: #9d3b35; }
.small-empty { padding: 50rpx 20rpx; color: #8d8177; text-align: center; font-size: 23rpx; }
