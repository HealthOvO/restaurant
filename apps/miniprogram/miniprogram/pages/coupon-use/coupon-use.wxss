.coupon-use-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.coupon-use-heading { padding: 14rpx 4rpx 26rpx; }
.free-order-note { display: flex; align-items: center; gap: 12rpx; padding: 22rpx 24rpx; color: #77551a; background: #f6eacb; border: 1rpx solid #ead9ad; border-radius: 20rpx; font-size: 22rpx; }
.free-order-note strong { color: #5e3e0e; }
.free-order-note text:last-child { margin-left: auto; color: #8d7040; }
.coupon-spec { margin-top: 20rpx; padding: 28rpx 26rpx; }
.spec-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 27rpx; font-weight: 720; }
.spec-heading text:last-child { color: #8d8177; font-size: 21rpx; font-weight: 500; }
.choice-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.choice-chip { display: flex; min-height: 68rpx; align-items: center; gap: 8rpx; margin: 0; padding: 12rpx 20rpx; color: #594c43; background: #f1ece5; border: 1rpx solid transparent; border-radius: 16rpx; font-size: 24rpx; }
.choice-chip.is-selected { color: #8f321f; background: #f7e3dc; border-color: #b95f48; }
.choice-chip[disabled] { color: #aaa097; background: #eeeae4; }
.choice-chip text:last-child:not(:first-child) { font-size: 18rpx; }
.coupon-submit-bar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 253, 250, .98); border-top: 1rpx solid #e5ddd3; box-shadow: 0 -8rpx 28rpx rgba(52, 38, 29, .06); }
.coupon-submit-bar > view { display: flex; flex-direction: column; color: #8d8177; font-size: 20rpx; }
.coupon-submit-bar strong { color: #2a211c; font-size: 34rpx; }
.coupon-submit-bar .primary-button { min-width: 300rpx; margin: 0; }
