<view class="page coupon-use-page">
  <view wx:if="{{loading}}" class="loading-state"><view class="loading-dot"></view><text>正在准备商品券</text></view>
  <view wx:elif="{{error}}" class="error-state"><view class="state-mark">!</view><text class="state-title">暂时不能使用</text><text class="state-copy">{{error}}</text><button class="secondary-button" bindtap="loadCoupon">重新加载</button></view>

  <block wx:elif="{{coupon && product}}">
    <view class="coupon-use-heading"><text class="eyebrow">商品券下单</text><view class="page-title">{{product.name}}</view><text class="page-subtitle">本单实付 0 元，提交后会直接生成取餐号。</text></view>
    <view class="free-order-note"><text>使用</text><strong>{{coupon.name}}</strong><text>本单不再获得消费积分</text></view>

    <view wx:for="{{product.specGroups}}" wx:key="id" wx:for-item="group" class="coupon-spec surface">
      <view class="spec-heading"><text>{{group.name}}</text><text>{{group.required ? '必选' : '可选'}}</text></view>
      <view class="choice-grid">
        <button wx:for="{{group.choices}}" wx:key="id" wx:for-item="choice" class="choice-chip {{choice.selected ? 'is-selected' : ''}}" disabled="{{!choice.couponEnabled}}" data-group-id="{{group.id}}" data-choice-id="{{choice.id}}" bindtap="toggleChoice"><text>{{choice.name}}</text><text wx:if="{{choice.priceDelta > 0}}">券不可选</text></button>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{coupon && product}}" class="coupon-submit-bar">
  <view><text>应付</text><strong>¥0.00</strong></view>
  <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交并取号</button>
</view>
