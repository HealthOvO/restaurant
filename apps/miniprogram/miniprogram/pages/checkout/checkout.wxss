.checkout-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.checkout-heading { margin: 4rpx 4rpx 24rpx; }
.checkout-card { overflow: hidden; }
.checkout-line { display: flex; align-items: flex-start; justify-content: space-between; gap: 22rpx; padding: 26rpx 24rpx; border-top: 1rpx solid #e4ddd2; }
.checkout-line:first-child { border-top: 0; }
.checkout-line-main { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.checkout-product { font-size: 29rpx; font-weight: 720; }
.checkout-spec { color: #756a61; font-size: 23rpx; line-height: 1.5; }
.checkout-price { color: #9a6b2d; font-size: 21rpx; }
.checkout-line-side { display: flex; align-items: flex-end; flex-direction: column; gap: 18rpx; }
.checkout-line-total { font-size: 27rpx; font-weight: 700; }
.mini-stepper { display: flex; align-items: center; gap: 16rpx; }
.mini-stepper button { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; padding: 0; color: #4b4038; background: #eee8df; border-radius: 16rpx; font-size: 28rpx; }
.mini-stepper text { min-width: 28rpx; text-align: center; font-size: 24rpx; font-weight: 650; }
.checkout-summary { margin-top: 18rpx; padding: 8rpx 24rpx; }
.checkout-summary > view { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #e4ddd2; }
.checkout-summary > view:first-child { border-top: 0; }
.checkout-summary text { color: #756a61; font-size: 24rpx; }
.checkout-summary strong { font-size: 29rpx; }
.points-value { color: #9a5b17; }
.checkout-note { margin-top: 20rpx; padding: 0 8rpx; color: #8d8177; font-size: 22rpx; line-height: 1.6; }
.checkout-error { margin-top: 18rpx; padding: 18rpx 20rpx; color: #872d2d; background: #f8e4e2; border: 1rpx solid #ecc8c4; border-radius: 18rpx; font-size: 23rpx; line-height: 1.5; }
.checkout-submit-bar { position: fixed; z-index: 50; right: 0; bottom: 0; left: 0; display: flex; min-height: 130rpx; align-items: center; justify-content: space-between; gap: 24rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,252,247,.97); border-top: 1rpx solid #e4ddd2; }
.checkout-submit-bar > view { display: flex; flex-direction: column; gap: 3rpx; }
.checkout-submit-bar text { color: #756a61; font-size: 21rpx; }
.checkout-submit-bar strong { color: #a9402b; font-size: 35rpx; }
.checkout-submit-bar .primary-button { min-width: 290rpx; }
