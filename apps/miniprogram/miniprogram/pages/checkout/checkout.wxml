<view class="page checkout-page">
  <view class="checkout-heading">
    <text class="eyebrow">确认内容</text>
    <view class="page-title">这单吃什么</view>
    <text class="page-subtitle">支付成功后才会生成取餐号和积分。</text>
  </view>

  <view wx:if="{{cart.length}}" class="checkout-card surface">
    <view wx:for="{{cart}}" wx:key="key" class="checkout-line">
      <view class="checkout-line-main">
        <text class="checkout-product">{{item.productName}}</text>
        <text class="checkout-spec">{{item.specText}}</text>
        <text class="checkout-price">{{item.unitPriceText}} / 份</text>
      </view>
      <view class="checkout-line-side">
        <text class="checkout-line-total">{{item.lineTotalText}}</text>
        <view class="mini-stepper">
          <button data-key="{{item.key}}" data-offset="-1" bindtap="changeQuantity">−</button>
          <text>{{item.quantity}}</text>
          <button data-key="{{item.key}}" data-offset="1" bindtap="changeQuantity">+</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{cart.length}}" class="checkout-summary surface">
    <view><text>共 {{summary.count}} 份</text><strong>{{summary.amountText}}</strong></view>
    <view><text>支付成功预计获得</text><strong class="points-value">+{{summary.points}} 积分</strong></view>
  </view>

  <view wx:if="{{error}}" class="checkout-error">{{error}}</view>

  <view wx:if="{{cart.length}}" class="checkout-note">
    <text>支付完成后请留意取餐号。订单需要退款时，请联系摊主处理。</text>
  </view>

  <view wx:else class="empty-state">
    <view class="state-mark">空</view>
    <text class="state-title">购物车还是空的</text>
    <text class="state-copy">返回点餐页选择商品。</text>
  </view>
</view>

<view wx:if="{{cart.length}}" class="checkout-submit-bar">
  <view><text>应付</text><strong>{{summary.amountText}}</strong></view>
  <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{submitting ? '正在提交' : '微信支付'}}</button>
</view>
