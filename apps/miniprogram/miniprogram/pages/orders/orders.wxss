.orders-heading { padding: 14rpx 4rpx 28rpx; }
.order-list { display: flex; flex-direction: column; gap: 20rpx; }
.order-card { padding: 24rpx; }
.order-card-head, .order-meta, .pickup-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.order-card-head { padding-bottom: 20rpx; border-bottom: 1rpx solid #eee7dd; }
.order-source { display: flex; align-items: center; gap: 14rpx; color: #8d8177; font-size: 21rpx; }
.pickup-row { margin: 22rpx 0; padding: 22rpx 24rpx; color: #756a61; background: #f7efe2; border-radius: 20rpx; font-size: 24rpx; }
.pickup-row strong { color: #a9402b; font-size: 54rpx; line-height: 1; letter-spacing: 4rpx; }
.order-content { display: flex; flex-direction: column; gap: 16rpx; padding-top: 20rpx; }
.order-items { color: #342a24; font-size: 27rpx; font-weight: 650; line-height: 1.55; }
.order-meta { color: #8d8177; font-size: 23rpx; }
.order-meta strong { color: #2a211c; font-size: 27rpx; }
.order-points { margin-top: 20rpx; padding-top: 18rpx; color: #2f6b4f; border-top: 1rpx solid #eee7dd; font-size: 23rpx; font-weight: 650; }
.order-points.is-coupon { color: #77551a; }
