<view class="page orders-page">
  <view class="orders-heading">
    <text class="eyebrow">取餐进度</text>
    <view class="page-title">我的订单</view>
    <text class="page-subtitle">微信支付和商品券订单都会显示在这里。</text>
  </view>

  <view wx:if="{{loading}}" class="loading-state"><view class="loading-dot"></view><text>正在加载订单</text></view>
  <view wx:elif="{{error}}" class="error-state">
    <view class="state-mark">!</view><text class="state-title">订单暂时没加载出来</text><text class="state-copy">{{error}}</text>
    <button class="secondary-button" bindtap="loadOrders">重新加载</button>
  </view>
  <view wx:elif="{{!orders.length}}" class="empty-state">
    <view class="state-mark">单</view><text class="state-title">还没有订单</text><text class="state-copy">点餐后可在这里查看进度。</text>
    <button class="primary-button" bindtap="goHome">去点餐</button>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="_id" class="order-card surface">
      <view class="order-card-head">
        <view class="order-source"><text class="source-pill {{item.sourceClass}}">{{item.sourceText}}</text><text>{{item.timeText}}</text></view>
        <text class="status-pill {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view wx:if="{{item.pickupNumber}}" class="pickup-row">
        <text>取餐号</text><strong>{{item.pickupNumber}}</strong>
      </view>
      <view class="order-content">
        <text class="order-items">{{item.itemText}}</text>
        <view class="order-meta"><text>共 {{item.itemCount}} 份</text><strong>{{item.amountText}}</strong></view>
      </view>
      <view wx:if="{{item.paidAmount > 0 && item.buyerPoints > 0 && item.settledAt && item.status !== 'REFUNDED'}}" class="order-points">本单已获得 +{{item.buyerPoints}} 积分</view>
      <view wx:if="{{item.paidAmount > 0 && item.buyerPoints > 0 && item.status === 'REFUNDED'}}" class="order-points is-refunded">本单积分已回收</view>
      <view wx:if="{{item.couponCount > 0}}" class="order-points is-coupon">本单使用 {{item.couponCount}} 张商品券</view>
    </view>
  </view>
</view>
