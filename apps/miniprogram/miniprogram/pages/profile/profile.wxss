.profile-card { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; color: #fffaf3; background: #4d392e; border-radius: 30rpx; }
.profile-avatar { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; color: #7a321f; background: #f2c792; border-radius: 30rpx; font-size: 38rpx; font-weight: 800; }
.profile-main { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; color: #d9cbbf; font-size: 21rpx; }
.profile-name { color: #fff; font-size: 30rpx; font-weight: 750; }
.profile-points { display: flex; flex-direction: column; align-items: flex-end; color: #d9cbbf; font-size: 20rpx; }
.profile-points strong { color: #f2c792; font-size: 40rpx; }
.invite-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 26rpx; }
.invite-card > view { display: flex; flex-direction: column; gap: 7rpx; }
.invite-label { color: #8d8177; font-size: 21rpx; }
.invite-card strong { font-size: 38rpx; letter-spacing: 4rpx; }
.invite-card .secondary-button { width: 150rpx; min-height: 70rpx; margin: 0; }
.bound-card { display: flex; align-items: center; gap: 20rpx; padding: 26rpx; }
.bound-mark { display: flex; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; color: #2f6b4f; background: #e1eee7; border-radius: 20rpx; font-size: 30rpx; }
.bound-card > view:last-child { display: flex; flex-direction: column; gap: 7rpx; color: #8d8177; font-size: 21rpx; }
.bound-card strong { color: #2a211c; font-size: 28rpx; }
.bind-card { display: flex; flex-direction: column; gap: 18rpx; padding: 26rpx; }
.bind-title { font-size: 28rpx; font-weight: 720; }
.bind-copy { color: #8d8177; font-size: 22rpx; line-height: 1.6; }
.invitee-list { padding: 0 24rpx; }
.invitee-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 23rpx 0; border-bottom: 1rpx solid #eee7dd; }
.invitee-row:last-child { border-bottom: 0; }
.invitee-row > view { display: flex; flex-direction: column; gap: 7rpx; font-size: 26rpx; font-weight: 650; }
.invitee-row small { color: #8d8177; font-size: 20rpx; font-weight: 400; }
.invitee-row strong { color: #2f6b4f; font-size: 22rpx; }
.small-empty { padding: 46rpx 20rpx; color: #8d8177; text-align: center; font-size: 23rpx; }
