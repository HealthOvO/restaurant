.store-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx 28rpx 26rpx;
  color: #fffaf3;
  background: #763522;
  border-radius: 30rpx;
}

.store-hero::after {
  position: absolute;
  top: -90rpx;
  right: -70rpx;
  width: 250rpx;
  height: 250rpx;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 48% 52% 62% 38%;
  transform: rotate(20deg);
  content: "";
}

.store-hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.store-hero .eyebrow { color: #f1c58a; }
.store-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 760; }

.business-state {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 14rpx;
  color: #d6cbc3;
  background: rgba(0,0,0,.18);
  border-radius: 999rpx;
  font-size: 21rpx;
}

.business-dot { width: 12rpx; height: 12rpx; background: #aaa098; border-radius: 50%; }
.business-state.is-open { color: #e2f5e9; background: rgba(49,111,82,.38); }
.business-state.is-open .business-dot { background: #8ed1ad; }
.store-announcement { position: relative; z-index: 1; display: block; margin-top: 14rpx; color: rgba(255,250,243,.72); font-size: 24rpx; }

.member-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 28rpx;
  padding: 20rpx;
  background: rgba(255,255,255,.09);
  border: 1rpx solid rgba(255,255,255,.11);
  border-radius: 20rpx;
}

.member-strip > view:not(.member-divider) { display: flex; min-width: 100rpx; flex-direction: column; gap: 3rpx; }
.member-strip text { color: rgba(255,250,243,.68); font-size: 20rpx; }
.member-strip strong { font-size: 32rpx; }
.member-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,.18); }
.member-link { margin-left: auto; padding: 8rpx 12rpx; color: #fff8ee; background: transparent; font-size: 22rpx; font-weight: 650; }

.closed-notice { display: flex; margin-top: 22rpx; flex-direction: column; gap: 8rpx; padding: 22rpx; color: #756a61; font-size: 23rpx; }
.closed-title { color: #2a211c; font-size: 28rpx; font-weight: 700; }
.product-list { display: grid; gap: 18rpx; }

.product-card { display: flex; min-height: 228rpx; overflow: hidden; }
.product-card.is-sold-out { opacity: .68; }
.product-photo { position: relative; width: 232rpx; flex: 0 0 auto; background: #e9e1d7; }
.product-photo image { width: 100%; height: 100%; }
.photo-placeholder { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #a9402b; background: #f2dfd6; font-size: 30rpx; font-weight: 750; }
.sold-out-mark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: white; background: rgba(45,38,34,.54); font-size: 27rpx; font-weight: 700; }
.product-info { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: space-between; padding: 22rpx; }
.product-info > view:first-child { display: flex; flex-direction: column; gap: 8rpx; }
.product-name { font-size: 31rpx; font-weight: 750; }
.product-description { display: -webkit-box; overflow: hidden; color: #7d7168; font-size: 23rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }
.product-bottom > view:first-child { display: flex; flex-direction: column; gap: 5rpx; }
.product-price { color: #a9402b; font-size: 31rpx; font-weight: 760; }
.points-hint { color: #9a6b2d; font-size: 20rpx; }
.add-button { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; color: white; background: #a9402b; border-radius: 18rpx; font-size: 36rpx; line-height: 1; }

.cart-bar {
  position: fixed;
  z-index: 50;
  right: 20rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  display: flex;
  min-height: 102rpx;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 16rpx 14rpx 20rpx;
  color: #fffaf3;
  background: #2d2824;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(45,40,36,.24);
}

.cart-count { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; color: #552819; background: #f0cfa2; border-radius: 50%; font-size: 23rpx; font-weight: 800; }
.cart-summary { display: flex; flex: 1; flex-direction: column; gap: 2rpx; }
.cart-summary strong { font-size: 30rpx; }
.cart-summary text { color: #bcb2a9; font-size: 20rpx; }
.checkout-link { padding: 18rpx 22rpx; color: #fff; background: #a9402b; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }

.sheet-title-row > view:first-child { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.sheet-copy { color: #756a61; font-size: 23rpx; line-height: 1.5; }
.spec-group { margin-top: 30rpx; }
.spec-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.spec-heading text:first-child { font-size: 27rpx; font-weight: 700; }
.spec-heading text:last-child { color: #8d8177; font-size: 21rpx; }
.choice-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.choice-chip { display: flex; min-height: 68rpx; align-items: center; gap: 8rpx; padding: 12rpx 22rpx; color: #554940; background: #f0ebe4; border: 1rpx solid transparent; border-radius: 16rpx; font-size: 24rpx; }
.choice-chip text:last-child:not(:first-child) { color: #a9402b; font-size: 20rpx; }
.choice-chip.is-selected { color: #84321f; background: #f6e5df; border-color: #b85843; }
.choice-chip[disabled] { opacity: .45; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 22rpx 0; border-top: 1rpx solid #e4ddd2; border-bottom: 1rpx solid #e4ddd2; font-size: 27rpx; font-weight: 700; }
.stepper { display: flex; align-items: center; gap: 20rpx; }
.stepper button { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; padding: 0; color: #4b4038; background: #eee8df; border-radius: 18rpx; font-size: 32rpx; }
.stepper button[disabled] { opacity: .38; }
.stepper text { min-width: 36rpx; text-align: center; }
.sheet-submit-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 26rpx; }
.sheet-submit-row > view { display: flex; flex-direction: column; gap: 3rpx; }
.sheet-points { color: #9a6b2d; font-size: 20rpx; }
.sheet-submit-row .primary-button { min-width: 260rpx; }
