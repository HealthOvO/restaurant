.store-hero {
  position: relative;
  padding: 14rpx 4rpx 4rpx;
}

.store-hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.store-hero .eyebrow { color: #a44732; }
.store-title { margin-top: 8rpx; color: #2f251f; font-size: 50rpx; font-weight: 780; letter-spacing: -1rpx; }

.business-state {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 14rpx;
  color: #756a61;
  background: #ebe5dd;
  border: 1rpx solid #dfd7cd;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.business-dot { width: 12rpx; height: 12rpx; background: #a59b92; border-radius: 50%; }
.business-state.is-open { color: #2f6b4f; background: #e4f0e8; border-color: #cfe2d6; }
.business-state.is-open .business-dot { background: #4d8b6b; }
.store-announcement { position: relative; z-index: 1; display: block; margin-top: 14rpx; color: #766b62; font-size: 24rpx; line-height: 1.55; }

.member-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  color: #fffaf3;
  background: linear-gradient(135deg, #41332c, #554036);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(54, 39, 30, .13);
}

.member-strip > view:not(.member-divider) { display: flex; min-width: 100rpx; flex-direction: column; gap: 3rpx; }
.member-strip text { color: rgba(255,250,243,.62); font-size: 20rpx; }
.member-strip strong { color: #fffaf3; font-size: 34rpx; }
.member-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,.18); }
.member-link { width: auto; min-height: 60rpx; flex: 0 0 auto; margin-left: auto; padding: 8rpx 12rpx; color: #f2d6b0; background: transparent; font-size: 22rpx; font-weight: 650; }

.closed-notice { display: flex; margin-top: 22rpx; flex-direction: column; gap: 8rpx; padding: 22rpx; color: #756a61; font-size: 23rpx; }
.closed-title { color: #2a211c; font-size: 28rpx; font-weight: 700; }
.menu-heading > view { display: flex; align-items: baseline; gap: 14rpx; }
.menu-count { color: #9a8f86; font-size: 20rpx; }
.product-list { display: grid; gap: 18rpx; }

.product-card { display: flex; min-height: 220rpx; overflow: hidden; }
.product-card.is-sold-out { opacity: .68; }
.product-photo { position: relative; width: 220rpx; flex: 0 0 auto; background: #f1e5d9; }
.product-photo image { width: 100%; height: 100%; }
.photo-placeholder { display: flex; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #9a5f43; background: linear-gradient(145deg, #f5e9dc, #ead7c4); font-size: 19rpx; font-weight: 650; letter-spacing: 2rpx; }
.food-illustration { position: relative; width: 104rpx; height: 86rpx; }
.steam { position: absolute; top: 0; width: 18rpx; height: 36rpx; border-left: 4rpx solid rgba(137, 77, 49, .54); border-radius: 50%; transform: rotate(12deg); }
.steam-one { left: 30rpx; }
.steam-two { left: 60rpx; top: 7rpx; transform: rotate(-10deg); }
.food-bowl { position: absolute; right: 6rpx; bottom: 0; left: 6rpx; height: 48rpx; overflow: hidden; background: #fff8ee; border: 4rpx solid #9b5f43; border-top-width: 3rpx; border-radius: 8rpx 8rpx 50rpx 50rpx; }
.food-bowl::before { position: absolute; top: -8rpx; left: -4rpx; width: 96rpx; height: 18rpx; background: #d99168; border: 4rpx solid #9b5f43; border-radius: 50%; content: ""; }
.food-bowl view { position: absolute; right: 20rpx; bottom: -1rpx; left: 20rpx; height: 5rpx; background: #9b5f43; border-radius: 999rpx; }
.sold-out-mark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: white; background: rgba(45,38,34,.54); font-size: 27rpx; font-weight: 700; }
.product-info { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: space-between; padding: 24rpx 22rpx; }
.product-info > view:first-child { display: flex; flex-direction: column; gap: 8rpx; }
.product-name { font-size: 30rpx; font-weight: 760; }
.product-description { display: -webkit-box; overflow: hidden; color: #7d7168; font-size: 23rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }
.product-bottom > view:first-child { display: flex; flex-direction: column; gap: 5rpx; }
.product-price { color: #a44732; font-size: 31rpx; font-weight: 770; }
.points-hint { color: #9a6b2d; font-size: 20rpx; }
.add-button { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; color: white; background: #a44732; border-radius: 20rpx; font-size: 36rpx; line-height: 1; box-shadow: 0 7rpx 14rpx rgba(164, 71, 50, .18); }

.cart-bar {
  position: fixed;
  z-index: 50;
  right: 20rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  display: flex;
  min-height: 102rpx;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 16rpx 14rpx 20rpx;
  color: #fffaf3;
  background: #2d2824;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(45,40,36,.24);
}

.cart-count { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; color: #552819; background: #f0cfa2; border-radius: 50%; font-size: 23rpx; font-weight: 800; }
.cart-summary { display: flex; flex: 1; flex-direction: column; gap: 2rpx; }
.cart-summary strong { font-size: 30rpx; }
.cart-summary text { color: #bcb2a9; font-size: 20rpx; }
.checkout-link { padding: 18rpx 22rpx; color: #fff; background: #a44732; border-radius: 18rpx; font-size: 26rpx; font-weight: 700; }

.sheet-title-row > view:first-child { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.sheet-copy { color: #756a61; font-size: 23rpx; line-height: 1.5; }
.spec-group { margin-top: 30rpx; }
.spec-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.spec-heading text:first-child { font-size: 27rpx; font-weight: 700; }
.spec-heading text:last-child { color: #8d8177; font-size: 21rpx; }
.choice-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.choice-chip { display: flex; width: auto; min-height: 68rpx; flex: 0 0 auto; align-items: center; gap: 8rpx; padding: 12rpx 22rpx; color: #554940; background: #f0ebe4; border: 1rpx solid transparent; border-radius: 16rpx; font-size: 24rpx; }
.choice-chip text:last-child:not(:first-child) { color: #a44732; font-size: 20rpx; }
.choice-chip.is-selected { color: #84321f; background: #f6e5df; border-color: #b85843; }
.choice-chip.is-disabled { opacity: .45; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 22rpx 0; border-top: 1rpx solid #e4ddd2; border-bottom: 1rpx solid #e4ddd2; font-size: 27rpx; font-weight: 700; }
.stepper { display: flex; align-items: center; gap: 20rpx; }
.stepper button { display: flex; width: 60rpx; min-width: 60rpx; height: 60rpx; flex: 0 0 60rpx; align-items: center; justify-content: center; padding: 0; color: #4b4038; background: #eee8df; border-radius: 18rpx; font-size: 32rpx; }
.stepper button[disabled] { opacity: .38; }
.stepper text { min-width: 36rpx; text-align: center; }
.sheet-submit-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 26rpx; }
.sheet-submit-row > view { display: flex; flex-direction: column; gap: 3rpx; }
.sheet-points { color: #9a6b2d; font-size: 20rpx; }
.sheet-submit-row .primary-button { min-width: 260rpx; }
