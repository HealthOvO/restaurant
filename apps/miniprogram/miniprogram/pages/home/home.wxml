<view class="menu-page {{cartInfo.count > 0 ? 'has-cart' : ''}}">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-dot"></view><text>正在准备菜单</text>
  </view>

  <view wx:elif="{{error}}" class="error-state page-state">
    <view class="state-mark">!</view>
    <text class="state-title">菜单暂时没打开</text>
    <text class="state-copy">{{error}}</text>
    <button class="secondary-button" bindtap="loadHome">重新加载</button>
  </view>

  <block wx:elif="{{home}}">
    <view class="menu-header">
      <view class="store-line">
        <view class="store-copy">
          <text class="eyebrow">现点现煮</text>
          <text class="store-name">{{home.config.storeName}}</text>
          <text class="store-note">{{home.config.announcement || '新鲜现做，叫号取餐'}}</text>
        </view>
        <view class="business-state {{home.config.businessOpen ? 'is-open' : ''}}">
          <view class="business-dot"></view>
          <text>{{home.config.businessOpen ? '营业中' : '暂停接单'}}</text>
        </view>
      </view>
      <button class="member-summary" bindtap="goBenefits">
        <view><strong>{{home.member.pointsBalance}}</strong><text>积分</text></view>
        <view class="member-divider"></view>
        <view><strong>{{home.availableCouponCount}}</strong><text>商品券</text></view>
        <text class="member-action">我的权益</text>
      </button>
      <view wx:if="{{!home.config.businessOpen}}" class="closed-strip">暂停接单期间，商品券仍可正常使用</view>
    </view>

    <view class="catalog-shell">
      <scroll-view class="category-rail" scroll-y="true" enhanced="true" show-scrollbar="false">
        <button
          wx:for="{{categories}}"
          wx:key="_id"
          class="category-item {{activeCategoryId === item._id ? 'is-active' : ''}}"
          data-id="{{item._id}}"
          bindtap="selectCategory"
        >
          <text>{{item.name}}</text>
          <small wx:if="{{item.isCoupon && item.count > 0}}">{{item.count}}</small>
        </button>
      </scroll-view>

      <scroll-view class="catalog-content" scroll-y="true" enhanced="true" show-scrollbar="false" scroll-with-animation="true">
        <view class="catalog-heading">
          <text>{{activeCategoryName}}</text>
          <small wx:if="{{activeCategoryId === '__coupons__'}}">选择后加入购物车</small>
        </view>

        <view wx:if="{{activeCategoryId !== '__coupons__'}}" class="product-list">
          <view
            wx:for="{{visibleProducts}}"
            wx:key="_id"
            class="product-row {{item.soldOut ? 'is-sold-out' : ''}}"
            data-id="{{item._id}}"
            bindtap="openProduct"
          >
            <view class="product-photo">
              <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true" aria-label="{{item.name}}" />
              <view wx:else class="photo-placeholder" aria-label="{{item.name}}暂无图片">
                <view class="food-bowl"><view></view></view>
              </view>
              <text wx:if="{{item.soldOut}}" class="sold-out-mark">已售罄</text>
            </view>
            <view class="product-info">
              <view class="product-main">
                <text class="product-name">{{item.name}}</text>
                <text class="product-description">{{item.description || '现点现煮'}}</text>
              </view>
              <view class="product-bottom">
                <view class="product-price-line">
                  <text class="product-price">{{item.priceText}}</text>
                  <text wx:if="{{item.pointsText}}" class="points-hint">{{item.pointsText}}</text>
                </view>
                <button class="add-button" disabled="{{item.soldOut}}" aria-label="{{item.soldOut ? item.name + '已售罄' : '选择' + item.name}}">{{item.soldOut ? '售罄' : '+'}}</button>
              </view>
            </view>
          </view>
          <view wx:if="{{!visibleProducts.length}}" class="catalog-empty">这个分类暂时没有商品</view>
        </view>

        <view wx:else class="coupon-menu-list">
          <view wx:for="{{visibleCoupons}}" wx:key="_id" class="coupon-menu-card" data-id="{{item._id}}" bindtap="openCoupon">
            <view class="coupon-ribbon">商品券</view>
            <view class="coupon-menu-main">
              <text class="coupon-menu-name">{{item.name}}</text>
              <text class="coupon-menu-product">可兑 {{item.productName}}</text>
              <text class="coupon-menu-expiry">{{item.expiresText}}</text>
            </view>
            <view class="coupon-menu-side">
              <text class="coupon-original">{{item.originalPriceText}}</text>
              <button class="coupon-add {{item.inCart ? 'is-added' : ''}}">{{item.inCart ? '已加入' : '使用'}}</button>
            </view>
          </view>
          <view wx:if="{{!visibleCoupons.length}}" class="catalog-empty">
            <text>暂时没有可用商品券</text>
            <button bindtap="goBenefits">去积分兑换</button>
          </view>
        </view>
        <view class="catalog-bottom-space"></view>
      </scroll-view>
    </view>
  </block>
</view>

<view wx:if="{{cartInfo.count > 0}}" class="cart-bar">
  <button class="cart-overview" bindtap="openCart">
    <view class="cart-count">{{cartInfo.count}}</view>
    <view class="cart-price">
      <strong>{{cartInfo.amountText}}</strong>
      <text wx:if="{{cartInfo.couponCount > 0}}">含 {{cartInfo.couponCount}} 张商品券</text>
      <text wx:elif="{{cartInfo.points > 0}}">可得 {{cartInfo.points}} 积分</text>
    </view>
    <text class="cart-expand">查看</text>
  </button>
  <button class="checkout-button" bindtap="goCheckout">去结算</button>
</view>

<view wx:if="{{cartOpen}}" class="sheet-backdrop cart-backdrop" bindtap="closeCart">
  <view class="cart-sheet" catchtap="preventClose">
    <view class="sheet-handle"></view>
    <view class="cart-sheet-header">
      <view><text>已选商品</text><small>共 {{cartInfo.count}} 份</small></view>
      <button bindtap="clearCartItems">清空</button>
    </view>
    <scroll-view class="cart-sheet-list" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view wx:for="{{cartItems}}" wx:key="key" class="cart-sheet-line">
        <view class="cart-line-copy">
          <view class="cart-line-title"><text>{{item.productName}}</text><small wx:if="{{item.isCoupon}}">券抵扣</small></view>
          <text class="cart-line-spec">{{item.specText}}</text>
          <view class="cart-line-price">
            <strong>{{item.priceText}}</strong>
            <del wx:if="{{item.isCoupon}}">{{item.originalPriceText}}</del>
          </view>
        </view>
        <view wx:if="{{!item.isCoupon}}" class="cart-stepper">
          <button data-key="{{item.key}}" data-offset="-1" bindtap="changeCartItem">−</button>
          <text>{{item.quantity}}</text>
          <button data-key="{{item.key}}" data-offset="1" bindtap="changeCartItem">+</button>
        </view>
        <button wx:else class="remove-coupon" data-key="{{item.key}}" bindtap="removeCartItem">移除</button>
      </view>
    </scroll-view>
    <view class="cart-sheet-footer">
      <view class="cart-total-copy">
        <view><text>应付</text><strong>{{cartInfo.amountText}}</strong></view>
        <small wx:if="{{cartInfo.discount > 0}}">商品券已抵扣 {{cartInfo.discountText}}</small>
      </view>
      <button class="checkout-button" bindtap="goCheckout">去结算</button>
    </view>
  </view>
</view>

<view wx:if="{{activeProduct}}" class="sheet-backdrop" bindtap="closeProduct">
  <scroll-view class="product-sheet" scroll-y="true" catchtap="preventClose" enhanced="true" show-scrollbar="false">
    <view class="sheet-handle"></view>
    <view class="product-sheet-heading">
      <view>
        <text wx:if="{{activeMode === 'COUPON'}}" class="sheet-kicker">使用商品券</text>
        <text class="sheet-product-name">{{activeProduct.name}}</text>
        <text class="sheet-product-description">{{activeProduct.description || '选择口味和小料'}}</text>
      </view>
      <button class="sheet-close" bindtap="closeProduct" aria-label="关闭">×</button>
    </view>

    <view wx:for="{{activeProduct.specGroups}}" wx:key="id" class="spec-group">
      <view class="spec-heading">
        <text>{{item.name}}</text>
        <small>{{item.required ? '必选' : '可选'}}{{item.mode === 'MULTIPLE' && item.maxSelect ? ' · 最多 ' + item.maxSelect + ' 项' : ''}}</small>
      </view>
      <view class="choice-grid">
        <button
          wx:for="{{item.choices}}"
          wx:for-item="choice"
          wx:key="id"
          class="choice-chip {{choice.selected ? 'is-selected' : ''}} {{!choice.selectable ? 'is-disabled' : ''}}"
          data-group-id="{{item.id}}"
          data-choice-id="{{choice.id}}"
          bindtap="toggleChoice"
          disabled="{{!choice.selectable}}"
        >
          <view class="choice-check"></view>
          <text>{{choice.name}}</text>
          <small wx:if="{{choice.priceDelta > 0}}">+{{choice.priceDelta / 100}} 元</small>
        </button>
      </view>
    </view>

    <view class="product-sheet-bottom">
      <view wx:if="{{activeMode === 'PAID'}}" class="quantity-stepper">
        <button data-offset="-1" bindtap="changeQuantity" disabled="{{quantity <= 1}}">−</button>
        <text>{{quantity}}</text>
        <button data-offset="1" bindtap="changeQuantity">+</button>
      </view>
      <view class="active-price">
        <del wx:if="{{activeMode === 'COUPON'}}">{{activeOriginalPriceText}}</del>
        <strong>{{activeUnitPriceText}}</strong>
        <text wx:if="{{activePoints > 0}}">可得 {{activePoints}} 积分</text>
      </view>
      <button class="add-confirm" bindtap="addToCart">{{activeMode === 'COUPON' ? '加入购物车' : '加入购物车'}}</button>
    </view>
  </scroll-view>
</view>
