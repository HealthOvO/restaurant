<view class="page {{cartInfo.count > 0 ? 'page-with-cart' : ''}}">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-dot"></view><text>正在准备菜单</text>
  </view>

  <view wx:elif="{{error}}" class="error-state">
    <view class="state-mark">!</view>
    <text class="state-title">菜单暂时没打开</text>
    <text class="state-copy">{{error}}</text>
    <button class="secondary-button" bindtap="loadHome">重新加载</button>
  </view>

  <block wx:elif="{{home}}">
    <view class="store-hero">
      <view class="store-hero-top">
        <view>
          <text class="eyebrow">现点现煮</text>
          <view class="store-title">{{home.config.storeName}}</view>
        </view>
        <view class="business-state {{home.config.businessOpen ? 'is-open' : ''}}">
          <view class="business-dot"></view>
          <text>{{home.config.businessOpen ? '营业中' : '暂停接单'}}</text>
        </view>
      </view>
      <text class="store-announcement">{{home.config.announcement || '新鲜现做，叫号取餐'}}</text>
      <view class="member-strip">
        <view>
          <text>可用积分</text>
          <strong>{{home.member.pointsBalance}}</strong>
        </view>
        <view class="member-divider"></view>
        <view>
          <text>可用商品券</text>
          <strong>{{home.availableCouponCount}}</strong>
        </view>
        <button class="member-link" bindtap="goBenefits">查看权益</button>
      </view>
    </view>

    <view wx:if="{{!home.config.businessOpen}}" class="closed-notice surface">
      <text class="closed-title">当前暂停接单</text>
      <text>菜单可以继续查看，恢复营业后即可下单。</text>
    </view>

    <view class="section-heading">
      <text class="section-heading-title">今天吃什么</text>
      <text class="section-heading-copy">选择口味和小料</text>
    </view>

    <view class="product-list">
      <view wx:for="{{products}}" wx:key="_id" class="product-card surface {{item.soldOut ? 'is-sold-out' : ''}}" data-id="{{item._id}}" bindtap="openProduct">
        <view class="product-photo">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true" />
          <view wx:else class="photo-placeholder">肉片</view>
          <text wx:if="{{item.soldOut}}" class="sold-out-mark">已售罄</text>
        </view>
        <view class="product-info">
          <view>
            <text class="product-name">{{item.name}}</text>
            <text class="product-description">{{item.description || '现点现煮'}}</text>
          </view>
          <view class="product-bottom">
            <view><text class="product-price">{{item.priceText}}</text><text class="points-hint">{{item.pointsText}}</text></view>
            <view class="add-button" aria-label="选择{{item.name}}">+</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!products.length}}" class="empty-state">
      <view class="state-mark">空</view>
      <text class="state-title">今天还没有上架商品</text>
      <text class="state-copy">请稍后再来看看。</text>
    </view>
  </block>
</view>

<view wx:if="{{cartInfo.count > 0}}" class="cart-bar" bindtap="goCheckout">
  <view class="cart-count">{{cartInfo.count}}</view>
  <view class="cart-summary"><strong>{{cartInfo.amountText}}</strong><text>预计得 {{cartInfo.points}} 积分</text></view>
  <view class="checkout-link">去结算</view>
</view>

<view wx:if="{{activeProduct}}" class="sheet-mask" bindtap="closeProduct"></view>
<view wx:if="{{activeProduct}}" class="bottom-sheet" catchtap="preventClose">
  <view class="sheet-handle"></view>
  <view class="sheet-title-row">
    <view><text class="sheet-title">{{activeProduct.name}}</text><text class="sheet-copy">{{activeProduct.description}}</text></view>
    <button class="close-button" bindtap="closeProduct">×</button>
  </view>
  <view class="spec-group" wx:for="{{activeProduct.specGroups}}" wx:key="id" wx:for-item="group">
    <view class="spec-heading"><text>{{group.name}}</text><text>{{group.required ? '必选' : '可选'}}{{group.mode === 'MULTIPLE' && group.maxSelect ? ' · 最多' + group.maxSelect + '项' : ''}}</text></view>
    <view class="choice-grid">
      <button wx:for="{{group.choices}}" wx:key="id" wx:for-item="choice" class="choice-chip {{choice.selected ? 'is-selected' : ''}}" disabled="{{!choice.enabled}}" data-group-id="{{group.id}}" data-choice-id="{{choice.id}}" bindtap="toggleChoice">
        <text>{{choice.name}}</text><text wx:if="{{choice.priceDelta > 0}}">+¥{{choice.priceDelta / 100}}</text>
      </button>
    </view>
  </view>
  <view class="quantity-row">
    <text>数量</text>
    <view class="stepper"><button data-offset="-1" bindtap="changeQuantity" disabled="{{quantity <= 1}}">−</button><text>{{quantity}}</text><button data-offset="1" bindtap="changeQuantity">+</button></view>
  </view>
  <view class="sheet-submit-row">
    <view><text class="sheet-price">{{activeUnitPriceText}}</text><text class="sheet-points">本次预计 +{{activeProduct.buyerPointsPerUnit * quantity}} 积分</text></view>
    <button class="primary-button" bindtap="addToCart">加入购物车</button>
  </view>
</view>
